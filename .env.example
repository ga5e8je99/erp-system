# ==============================================================================
# Masar ERP Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# IMPORTANT:
# - All server secrets must be kept confidential and NEVER committed to git.
# - In production, ensure strong random values are generated using `openssl rand`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL 15+) [REQUIRED]
# ------------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection URL.
# Supports postgresql://, postgres://, and prisma+postgres:// formats.
#
# For Localhost / Direct VPS:
DATABASE_URL="postgresql://postgres:<your-postgres-password>@localhost:5432/masar_erp?schema=public"
#
# For Docker Compose:
# DATABASE_URL="postgresql://masar_user:<your-strong-db-password>@postgres:5432/masar_erp?schema=public"

# (Docker Compose only) Database container credentials:
POSTGRES_USER="masar_user"
POSTGRES_PASSWORD="<replace-with-secure-postgres-password>"
POSTGRES_DB="masar_erp"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js / NextAuth v5) [REQUIRED]
# ------------------------------------------------------------------------------
# Secret key used to encrypt session tokens and cookies.
# Minimum 16 characters; min 32 characters strongly recommended.
# Generate via: openssl rand -base64 32
AUTH_SECRET="<generate-random-secret-min-32-chars-via-openssl>"

# [OPTIONAL] Set to "true" to trust reverse proxy headers (X-Forwarded-For, etc.):
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. Application Public Domain [OPTIONAL - Defaults to http://localhost:3000]
# ------------------------------------------------------------------------------
# Canonical public URL where users access the system.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Background Automated Tasks & Health Check Security [REQUIRED]
# ------------------------------------------------------------------------------
# Bearer secret token required to invoke cron notification routes (/api/cron/notifications)
# and retrieve detailed diagnostics from the health check (/api/health).
# MUST be at least 24 characters long in production environments.
# Generate via: openssl rand -hex 24
CRON_SECRET="<generate-random-secret-min-24-chars-via-openssl>"

# ------------------------------------------------------------------------------
# 5. Cloud Object Storage (Vercel Blob) [OPTIONAL in dev, REQUIRED on Vercel]
# ------------------------------------------------------------------------------
# When deploying to Vercel, attach a Vercel Blob store under the Storage tab
# to provide persistent file uploads (logos, receipts).
# In local development, leave unset to store files locally in public/uploads/:
# BLOB_READ_WRITE_TOKEN="<your-vercel-blob-read-write-token>"

# ------------------------------------------------------------------------------
# 6. Initial Administrator Password [REQUIRED in production for seed:prod]
# ------------------------------------------------------------------------------
# Password used when creating the initial administrator account (admin@masar.local).
# In production, seed:prod will throw an error if this variable is missing and the user does not exist.
# Must be at least 8 characters. Never use default or predictable passwords in production.
ADMIN_INITIAL_PASSWORD="<replace-with-strong-unique-initial-admin-password>"

# ------------------------------------------------------------------------------
# 7. Environment & Demo Seeding [OPTIONAL]
# ------------------------------------------------------------------------------
# Execution environment: "development" | "production" | "test" (default: "development")
NODE_ENV="development"

# Set to "false" to seed system essentials only (Chart of Accounts, roles, permissions).
# Set to "true" in local development to seed mock products, stock, and customers:
SEED_DEMO_DATA="false"

# ------------------------------------------------------------------------------
# 8. Production Reverse Proxy & SSL (Caddy / VPS Only) [OPTIONAL]
# ------------------------------------------------------------------------------
# Used when deploying with Caddy for automatic Let's Encrypt TLS:
DOMAIN="erp.yourcompany.com"
ACME_EMAIL="sysadmin@yourcompany.com"

# ------------------------------------------------------------------------------
# 9. Logging & Diagnostics [OPTIONAL]
# ------------------------------------------------------------------------------
# Log level: "trace" | "debug" | "info" | "warn" | "error" (default: "info" in production)
LOG_LEVEL="info"

# Optional webhook URL for external alert notifications (Slack/Discord):
# ERROR_WEBHOOK_URL="https://hooks.slack.com/services/..."
