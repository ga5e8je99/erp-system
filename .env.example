# ==============================================================================
# Masar ERP Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# For Docker Compose:
# DATABASE_URL="postgresql://masar_user:your_strong_db_password@postgres:5432/masar_erp?schema=public"
# For Localhost / Direct VPS:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/masar_erp?schema=public"

# Database credentials used by docker-compose for the postgres container:
POSTGRES_USER="masar_user"
POSTGRES_PASSWORD="change_this_to_a_secure_postgres_password"
POSTGRES_DB="masar_erp"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Generate a strong 32+ character key using: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-32-character-random-secret-key-for-prod"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. Application Public Domain
# ------------------------------------------------------------------------------
# The canonical public URL where the ERP system is accessed:
NEXT_PUBLIC_APP_URL="https://erp.yourcompany.com"

# ------------------------------------------------------------------------------
# 4. Background Automated Tasks & Cron Security
# ------------------------------------------------------------------------------
# Secret token required to trigger automated system notifications (/api/cron/notifications)
CRON_SECRET="generate-a-random-cron-secret-token"

# ------------------------------------------------------------------------------
# 5. Production Reverse Proxy & SSL (Caddy / Nginx)
# ------------------------------------------------------------------------------
# Domain name for Caddy automatic Let's Encrypt TLS:
DOMAIN="erp.yourcompany.com"
ACME_EMAIL="sysadmin@yourcompany.com"

# ------------------------------------------------------------------------------
# 6. Database Initialization / Seeding Options
# ------------------------------------------------------------------------------
# Initial password for default administrator (admin@masar.local) on first initialization:
ADMIN_INITIAL_PASSWORD="ChangeMe@12345!"

# In production, set to "false" to seed only system essentials (COA, roles, permissions).
# Set to "true" if you want to include demonstration products, customers, and employees.
SEED_DEMO_DATA="false"

# ------------------------------------------------------------------------------
# 7. Logging & Error Monitoring (Optional)
# ------------------------------------------------------------------------------
# Log level: "trace" | "debug" | "info" | "warn" | "error" (default: "info" in production)
LOG_LEVEL="info"

# Optional webhook URL for critical error alerts (Slack, Discord, or monitoring webhook):
# ERROR_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
